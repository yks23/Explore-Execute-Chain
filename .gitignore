*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Environments
.env
.venv
env/
venv/

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Ray and distributed training
/tmp/ray/
nohup.out

# Jupyter
.ipynb_checkpoints

# HuggingFace cache (if created in project)
.huggingface/


data/
generations/
evaluation/
models/
outputs/
